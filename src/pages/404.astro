---
import Base from '../layouts/Base.astro'
import { withBase } from '../lib/paths'
---
<Base title="Page not found">
  <section class="shell flex min-h-[70svh] flex-col justify-center py-32">
    <p class="label text-terracotta-ink mb-6">404</p>
    <h1 class="text-ink" style="font-size:var(--text-display-l)">That page has moved out.</h1>
    <p class="mt-5 max-w-[46ch] text-lg text-muted">
      The page you're after doesn't exist. The work is all on the home page.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={withBase("/")}
        class="label rounded-full bg-ink px-6 py-4 text-plaster transition-colors duration-300 hover:bg-charcoal"
      >Back home</a>
      <a
        href={withBase("/portfolio/")}
        class="label rounded-full border border-ink px-6 py-4 text-ink transition-colors duration-300 hover:bg-ink hover:text-plaster"
      >See all projects</a>
    </div>
  </section>
</Base>

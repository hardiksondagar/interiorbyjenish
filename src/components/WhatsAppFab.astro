---
import { waHref } from '../lib/site'
---
{/* is-shown and is-hidden can both be set at once (past the hero AND over the
    contact section). :not(.is-hidden) makes the hidden state win
    deterministically instead of depending on CSS source order. */}
<a
  data-fab
  href={waHref()}
  target="_blank"
  rel="noopener"
  aria-label="Message Interior by Jenish on WhatsApp"
  class="fixed bottom-5 right-5 z-50 flex items-center gap-2.5 rounded-full bg-terracotta px-5 py-4 text-shell shadow-lg
         translate-y-24 opacity-0 pointer-events-none
         transition-[transform,opacity] duration-500 ease-[var(--ease-out-quint)]
         [&.is-shown:not(.is-hidden)]:translate-y-0
         [&.is-shown:not(.is-hidden)]:opacity-100
         [&.is-shown:not(.is-hidden)]:pointer-events-auto
         hover:bg-terracotta-ink motion-reduce:transition-none"
>
  <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m5.8 14.06c-.25.7-1.44 1.33-1.98 1.38-.54.06-1.05.25-3.6-.75s-4.15-3.65-4.28-3.82c-.12-.17-.81-1.13-.81-2.16 0-1.02.54-1.52.73-1.73.2-.21.43-.26.57-.26.14 0 .29 0 .41.01.13 0 .31-.05.48.37.17.43.6 1.46.65 1.57.05.11.08.24.01.38-.07.15-.14.24-.28.37-.13.14-.28.31-.4.42-.13.12-.27.25-.12.5.15.24.68 1.12 1.46 1.81.99.88 1.83 1.16 2.09 1.29.26.13.41.11.56-.07.15-.17.65-.76.82-1.02.17-.26.35-.21.58-.13.24.09 1.5.71 1.76.84.26.13.43.19.5.3.06.11.06.63-.19 1.33"/></svg>
  <span class="label">WhatsApp</span>
</a>

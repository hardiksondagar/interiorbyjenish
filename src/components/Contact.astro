---
import { SITE, waHref, telHref, mailHref } from '../lib/site'
---
<section id="contact" class="section-y scroll-mt-20 bg-charcoal">
  <div class="shell">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="label text-clay mb-6">Start a project</p>
        <h2 class="text-plaster" style="font-size:var(--text-display-l)">
          Tell us about your space.
        </h2>
        <p class="mt-6 max-w-[48ch] text-lg text-plaster/70">
          Send a message with your location, carpet area and what you're planning.
          Jenish replies personally, usually the same day.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={waHref()}
            target="_blank"
            rel="noopener"
            class="label inline-flex items-center gap-2.5 rounded-full bg-terracotta px-6 py-4 text-shell hover:bg-terracotta-ink transition-colors duration-300"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m5.8 14.06c-.25.7-1.44 1.33-1.98 1.38-.54.06-1.05.25-3.6-.75s-4.15-3.65-4.28-3.82c-.12-.17-.81-1.13-.81-2.16 0-1.02.54-1.52.73-1.73.2-.21.43-.26.57-.26.14 0 .29 0 .41.01.13 0 .31-.05.48.37.17.43.6 1.46.65 1.57.05.11.08.24.01.38-.07.15-.14.24-.28.37-.13.14-.28.31-.4.42-.13.12-.27.25-.12.5.15.24.68 1.12 1.46 1.81.99.88 1.83 1.16 2.09 1.29.26.13.41.11.56-.07.15-.17.65-.76.82-1.02.17-.26.35-.21.58-.13.24.09 1.5.71 1.76.84.26.13.43.19.5.3.06.11.06.63-.19 1.33"/></svg>
            WhatsApp Jenish
          </a>
          <a
            href={telHref}
            class="label rounded-full border border-plaster/30 px-6 py-4 text-plaster hover:bg-plaster/10 transition-colors duration-300"
          >Call {SITE.phoneDisplay}</a>
          <a
            href={mailHref}
            class="label rounded-full border border-plaster/30 px-6 py-4 text-plaster hover:bg-plaster/10 transition-colors duration-300"
          >Email</a>
        </div>
      </div>

      <dl class="lg:col-span-5 lg:border-l lg:border-plaster/15 lg:pl-12 space-y-8">
        <div>
          <dt class="label text-plaster/45">Studio</dt>
          <dd class="mt-2.5 text-plaster">{SITE.addressLine}</dd>
        </div>
        <div>
          <dt class="label text-plaster/45">Service areas</dt>
          <dd class="mt-2.5 text-plaster">{SITE.serviceAreas.join(' · ')}</dd>
        </div>
        <div>
          <dt class="label text-plaster/45">Instagram</dt>
          <dd class="mt-2.5">
            <a
              href={SITE.instagramUrl}
              target="_blank"
              rel="noopener"
              class="text-plaster underline decoration-clay decoration-1 underline-offset-4 hover:decoration-plaster transition"
            >@{SITE.instagramHandle}</a>
          </dd>
        </div>
        <div>
          <dt class="label text-plaster/45">Scope</dt>
          <dd class="mt-2.5 text-plaster">
            Homes · Offices · Commercial · Modular kitchens · Turnkey execution
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

---
import SectionHeading from './SectionHeading.astro'

const steps = [
  { n: '01', title: 'Consultation', body: 'We measure the space, understand how you actually live or work in it, and agree a budget band before anything is drawn.' },
  { n: '02', title: '3D Visualisation', body: 'Every room is modelled and rendered in full. You approve finishes, lighting and joinery from photoreal views — not a mood board.' },
  { n: '03', title: 'AR / VR Walkthrough', body: 'Scan a code and stand inside your own room at full scale before we build it. Every one of our design sets ships this way.' },
  { n: '04', title: 'Working Drawings', body: 'Dimensioned joinery, ceiling and electrical layouts go to site, so the carpenter builds what you approved.' },
  { n: '05', title: 'Turnkey Execution', body: 'We run the trades, the schedule and the finish quality through to handover.' },
]
---
<section id="process" class="section-y scroll-mt-20">
  <div class="shell">
    <SectionHeading
      eyebrow="How We Work"
      title="A process built to remove surprises."
      lede="The reason our projects land on budget is that almost every decision is made before site work starts."
    />

    <ol class="mt-14 grid gap-px overflow-hidden border border-sand bg-sand md:grid-cols-2 lg:grid-cols-5">
      {steps.map((s, i) => (
        <li class="reveal bg-plaster p-7 lg:p-6" style={`--reveal-delay:${i * 90}ms`}>
          <p class="label text-terracotta-ink">{s.n}</p>
          <h3 class="mt-5 text-xl text-ink">{s.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

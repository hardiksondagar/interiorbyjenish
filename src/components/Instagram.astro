---
import SectionHeading from './SectionHeading.astro'
import { SITE } from '../lib/site'
import { INSTAGRAM_POSTS, INSTAGRAM_LIMIT } from '../data/instagram'

const posts = INSTAGRAM_POSTS.slice(0, INSTAGRAM_LIMIT)
---
<section id="instagram" class="section-y scroll-mt-20 bg-shell border-y border-sand">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="From the Studio"
        title="Fresh off site."
        lede="We post new work, site progress and finish details on Instagram most weeks."
      />
      <a
        href={SITE.instagramUrl}
        target="_blank"
        rel="noopener"
        class="label shrink-0 rounded-full border border-ink px-5 py-3.5 text-ink hover:bg-ink hover:text-plaster transition-colors duration-300"
      >Follow @{SITE.instagramHandle}</a>
    </div>

    {posts.length > 0 ? (
      <div
        data-instagram
        class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
      >
        {posts.map((url) => (
          <div class="relative min-h-[420px] overflow-hidden border border-sand bg-plaster">
            {/* Skeleton sits behind the embed so the iframe resizing can't
                shift layout. */}
            <div class="absolute inset-0 grid place-items-center" aria-hidden="true">
              <span class="label text-muted/60">Loading post…</span>
            </div>
            <blockquote
              class="instagram-media relative"
              data-instgrm-permalink={`${url.replace(/\/?$/, '/')}?utm_source=ig_embed`}
              data-instgrm-version="14"
              style="margin:0;width:100%;min-width:0;max-width:100%;background:transparent;border:0;box-shadow:none;"
            >
              <a href={url} target="_blank" rel="noopener" class="block p-6 text-sm text-muted">
                View this post on Instagram
              </a>
            </blockquote>
          </div>
        ))}
      </div>
    ) : (
      <div class="reveal mt-12 border border-dashed border-clay bg-plaster p-8 md:p-12">
        <p class="label text-terracotta-ink">Setup needed</p>
        <p class="mt-4 max-w-[58ch] text-muted">
          No posts are pinned yet. Add 6 post links to
          <code class="mx-1 rounded bg-sand px-1.5 py-0.5 text-sm text-ink">src/data/instagram.ts</code>
          and they'll appear here as live embeds.
        </p>
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener"
          class="label mt-6 inline-block rounded-full bg-ink px-5 py-3.5 text-plaster hover:bg-charcoal transition-colors duration-300"
        >Open Instagram instead</a>
      </div>
    )}
  </div>
</section>

<script>
  /** Instagram's embed.js plus one iframe per post is 1.5-3 MB of
   *  third-party payload. It is deliberately NOT in the document: the script
   *  and the preconnect are both injected only once the section is near the
   *  viewport, so it can never affect initial load or LCP. */
  const section = document.querySelector<HTMLElement>('[data-instagram]')
  if (section) {
    let loaded = false
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting) || loaded) return
      loaded = true
      io.disconnect()

      const pre = document.createElement('link')
      pre.rel = 'preconnect'
      pre.href = 'https://www.instagram.com'
      document.head.appendChild(pre)

      const s = document.createElement('script')
      s.async = true
      s.src = 'https://www.instagram.com/embed.js'
      s.onload = () => (window as any).instgrm?.Embeds?.process?.()
      document.body.appendChild(s)
    }, { rootMargin: '600px' })
    io.observe(section)
  }
</script>

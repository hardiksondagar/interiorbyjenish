---
import { getImage } from 'astro:assets'
import type { Project } from '../data/projects'

interface Props {
  /** Only these projects' gallery data is inlined. The home page shows a
   *  subset, so shipping all 22 would be ~10 KB gz of unusable payload. */
  projects: Project[]
}
const { projects: PROJECTS } = Astro.props

/** Pre-resolve two widths per gallery image at build time: a 1600px view and
 *  a 2400px one for large screens. Nothing is fetched until the dialog opens,
 *  because these land in data attributes rather than <img src>. */
const data = await Promise.all(
  PROJECTS.map(async (p) => ({
    slug: p.slug,
    title: p.title,
    meta: [p.type, p.locality].filter(Boolean).join(' · '),
    images: await Promise.all(
      p.gallery.map(async (g) => {
        const [md, lg] = await Promise.all([
          getImage({ src: g.src, format: 'webp', width: 1600, quality: 76 }),
          getImage({ src: g.src, format: 'webp', width: 2400, quality: 74 }),
        ])
        // No blur here: the lightbox shows a full image immediately, and the
        // LQIP data URIs were adding ~18 KB gz of unused payload to the page.
        return { md: md.src, lg: lg.src, alt: g.alt }
      }),
    ),
  })),
)
---
<script type="application/json" id="lightbox-data" set:html={JSON.stringify(data)} is:inline />

<dialog class="lightbox" data-lightbox aria-label="Project gallery">
  <div class="flex h-full flex-col">
    <div class="flex items-start justify-between gap-4 px-5 py-4 md:px-8">
      <div>
        <h2 class="text-plaster text-xl md:text-2xl" data-lb-title></h2>
        <p class="label mt-1.5 text-plaster/55" data-lb-meta></p>
      </div>
      <div class="flex items-center gap-2">
        <a
          class="label hidden sm:inline-block rounded-full border border-plaster/25 px-4 py-2.5 text-plaster/80 hover:bg-plaster/10 transition"
          data-lb-link
          href="#"
        >Full project</a>
        <button
          type="button"
          data-lb-close
          class="label rounded-full border border-plaster/25 px-4 py-2.5 text-plaster hover:bg-plaster/10 transition"
          aria-label="Close gallery"
        >Close</button>
      </div>
    </div>

    <div class="relative flex-1 min-h-0">
      <img
        data-lb-img
        class="absolute inset-0 h-full w-full object-contain"
        alt=""
      />
      <button
        type="button"
        data-lb-prev
        class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-charcoal/70 p-4 text-plaster hover:bg-charcoal transition"
        aria-label="Previous image"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button
        type="button"
        data-lb-next
        class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-charcoal/70 p-4 text-plaster hover:bg-charcoal transition"
        aria-label="Next image"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>

    <p class="label px-5 py-4 text-center text-plaster/55 md:px-8" data-lb-counter></p>
  </div>
</dialog>

<script>
  import '../scripts/lightbox'
</script>

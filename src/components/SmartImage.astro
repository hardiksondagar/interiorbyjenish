---
import { Picture } from 'astro:assets'
import type { GalleryImage } from '../data/projects'

interface Props {
  image: GalleryImage
  sizes: string
  widths?: number[]
  /** Only the hero/first card should be eager. */
  priority?: boolean
  class?: string
  ratio?: string
}

const {
  image,
  sizes,
  // Four widths, not five. These cover the real layout slots - phone (480),
  // phone@2x and grid card (960), tablet@2x and detail page (1600), lightbox
  // and large desktop (2400) - and every variant dropped is ~360 fewer image
  // encodes per build.
  widths = [480, 960, 1600, 2400],
  priority = false,
  class: cls = '',
  ratio,
} = Astro.props

// Never request widths larger than the master actually is.
const capped = widths.filter((w) => w <= image.width)
if (!capped.length) capped.push(image.width)
---
<div
  class={`relative overflow-hidden bg-sand ${cls}`}
  style={`${ratio ? `aspect-ratio:${ratio};` : ''}background-image:url('${image.blur}');background-size:cover;background-position:center;`}
>
  <Picture
    src={image.src}
    formats={['avif', 'webp']}
    {/* Fall back to WebP rather than the source JPEG. <Picture> renders the
        fallback format as a third full width-set, and WebP has been
        universally supported since 2020, so the JPEG set was ~600 wasted
        encodes per build for no browser that exists. */}
    fallbackFormat="webp"
    widths={capped}
    sizes={sizes}
    alt={image.alt}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="h-full w-full object-cover"
  />
</div>

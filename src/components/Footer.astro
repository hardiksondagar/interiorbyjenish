---
import Logo from './Logo.astro'
import { SITE, telHref, mailHref, mapHref } from '../lib/site'
import { withBase } from '../lib/paths'
const year = new Date().getFullYear()
---
<footer class="bg-ink py-14">
  <div class="shell">
    <div class="flex flex-wrap items-start justify-between gap-10">
      <div>
        <Logo class="text-base text-plaster" />
        <p class="mt-5 max-w-[36ch] text-sm text-plaster/55">
          Interior design and turnkey execution for homes and offices in {SITE.city}.
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-10 gap-y-3" aria-label="Footer">
        {[
          { href: withBase('/portfolio/'), label: 'Portfolio' },
          { href: withBase('/#films'), label: 'Films' },
          { href: withBase('/#process'), label: 'Process' },
          { href: withBase('/#contact'), label: 'Contact' },
          { href: SITE.instagramUrl, label: 'Instagram', ext: true },
        ].map((l) => (
          <a
            href={l.href}
            target={l.ext ? '_blank' : undefined}
            rel={l.ext ? 'noopener' : undefined}
            class="label text-plaster/60 hover:text-plaster transition-colors duration-300"
          >{l.label}</a>
        ))}
      </nav>

      <div class="space-y-2">
        <a href={telHref} class="block text-sm text-plaster/70 hover:text-plaster transition">{SITE.phoneDisplay}</a>
        <a href={mailHref} class="block text-sm text-plaster/70 hover:text-plaster transition">{SITE.email}</a>
        <a
          href={mapHref}
          target="_blank"
          rel="noopener"
          class="block max-w-[26ch] text-sm leading-relaxed text-plaster/55 hover:text-plaster transition"
        >New Narol, {SITE.city} {SITE.postalCode}</a>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-plaster/12 pt-7">
      <p class="label text-plaster/35">© {year} {SITE.name}</p>
      <p class="label text-plaster/35">{SITE.city} · {SITE.region}</p>
    </div>
  </div>
</footer>
